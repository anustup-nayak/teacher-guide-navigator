{
 "$id": "outcomes.schema.json",
 "type": "object",
 "required": [
  "pack",
  "outcomes"
 ],
 "additionalProperties": false,
 "properties": {
  "pack": {
   "$ref": "common.schema.json#/$defs/slug"
  },
  "outcomes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "grade",
     "statement",
     "provenance"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^([HM][0-9]{3}(\\.[0-9])?|g[0-9]-[a-z-]+-[0-9]+)$"
     },
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "list": {
      "enum": [
       "guide",
       "workbook"
      ]
     },
     "strand": {
      "enum": [
       "oral-language",
       "reading",
       "writing",
       "decoding",
       "number",
       "operations",
       "shapes-space",
       "measurement",
       "data-patterns"
      ]
     },
     "family": {
      "type": "string",
      "pattern": "^[A-Z]+[0-9]+$",
      "$comment": "printed code family, e.g. M101; Math groups outcomes by family instead of strand names"
     },
     "parent": {
      "type": "string"
     },
     "code": {
      "type": [
       "string",
       "null"
      ]
     },
     "statement": {
      "$ref": "common.schema.json#/$defs/text"
     },
     "nipun": {
      "type": "boolean"
     },
     "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
     },
     "equivalent": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/link"
      },
      "$comment": "crosswalk to the same outcome in the other list; shown only when reviewed"
     }
    }
   },
   "minItems": 1
  },
  "objectives": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "grade",
     "week",
     "statement",
     "outcomes",
     "provenance"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^g[0-9]-w[0-9]{2}-o[0-9]$"
     },
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "week": {
      "type": "integer"
     },
     "statement": {
      "$ref": "common.schema.json#/$defs/text"
     },
     "outcomes": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/link"
      }
     },
     "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
     }
    }
   }
  }
 }
}
