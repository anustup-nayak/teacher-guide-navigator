{
 "$id": "cards.schema.json",
 "$comment": "Smart lesson cards (docs/SMART_CARDS.md): an editorial summary layer over a lesson's own steps. Shown only when owner-approved.",
 "type": "object",
 "required": ["pack", "cards"],
 "additionalProperties": false,
 "properties": {
  "pack": {"$ref": "common.schema.json#/$defs/slug"},
  "cards": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["lesson", "layout", "title", "lines", "provenance"],
    "additionalProperties": false,
    "properties": {
     "lesson": {"type": "string", "pattern": "^g[0-9]-[a-z]+-w[0-9]{2}-d[0-9]{2}$"},
     "layout": {"enum": ["steps", "periods"]},
     "title": {"type": "string", "minLength": 2},
     "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "phase": {"type": "string"},
       "worksheet": {"type": "integer", "minimum": 0},
       "rect": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4}
      }
     },
     "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "object",
       "required": ["phases", "label", "text"],
       "additionalProperties": false,
       "properties": {
        "phases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "period": {"type": "integer", "minimum": 1, "maximum": 3},
        "label": {"type": "string", "minLength": 2},
        "minutes": {"type": "string"},
        "steps": {"type": "string"},
        "text": {"type": "string", "minLength": 4}
       }
      }
     },
     "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
    }
   }
  }
 }
}
