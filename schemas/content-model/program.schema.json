{
 "$id": "program.schema.json",
 "type": "object",
 "required": [
  "pack",
  "state",
  "subject",
  "academicYear",
  "grades",
  "documents",
  "provenance"
 ],
 "additionalProperties": false,
 "properties": {
  "pack": {
   "$ref": "common.schema.json#/$defs/slug"
  },
  "state": {
   "type": "string"
  },
  "subject": {
   "enum": [
    "hindi",
    "math"
   ]
  },
  "academicYear": {
   "type": "string",
   "pattern": "^20[0-9]{2}–[0-9]{2}$"
  },
  "grades": {
   "type": "array",
   "items": {
    "$ref": "common.schema.json#/$defs/grade"
   },
   "minItems": 1
  },
  "documents": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "grade",
     "title"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "guide",
       "workbook",
       "textbook"
      ]
     },
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "title": {
      "$ref": "common.schema.json#/$defs/bilingual"
     },
     "edition": {
      "type": "string"
     }
    }
   }
  },
  "provenance": {
   "$ref": "common.schema.json#/$defs/provenance"
  }
 },
 "$comment": "Edition and source documents. Calendar, weekly cycle and periods live in structure.json."
}
