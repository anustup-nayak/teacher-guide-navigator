{
 "$id": "program.schema.json",
 "type": "object",
 "required": [
  "pack",
  "state",
  "subject",
  "academicYear",
  "grades",
  "documents",
  "weeklyCycle",
  "periods",
  "provenance"
 ],
 "additionalProperties": false,
 "properties": {
  "pack": {
   "$ref": "common.schema.json#/$defs/slug"
  },
  "state": {
   "type": "string"
  },
  "subject": {
   "enum": [
    "hindi",
    "math"
   ]
  },
  "academicYear": {
   "type": "string",
   "pattern": "^20[0-9]{2}–[0-9]{2}$"
  },
  "grades": {
   "type": "array",
   "items": {
    "$ref": "common.schema.json#/$defs/grade"
   },
   "minItems": 1
  },
  "documents": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "grade",
     "title"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "guide",
       "workbook",
       "textbook"
      ]
     },
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "title": {
      "$ref": "common.schema.json#/$defs/bilingual"
     },
     "edition": {
      "type": "string"
     }
    }
   }
  },
  "weeks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "grade",
     "from",
     "to",
     "kind"
    ],
    "additionalProperties": false,
    "properties": {
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "from": {
      "type": "integer",
      "minimum": 1
     },
     "to": {
      "type": "integer",
      "minimum": 1
     },
     "kind": {
      "enum": [
       "teaching",
       "periodic-revision",
       "school-readiness",
       "class-review"
      ]
     },
     "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
     }
    }
   }
  },
  "weeklyCycle": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "day",
     "purpose"
    ],
    "additionalProperties": false,
    "properties": {
     "day": {
      "type": "integer",
      "minimum": 1
     },
     "purpose": {
      "enum": [
       "new-skills",
       "weekly-revision",
       "weekly-assessment",
       "consolidation",
       "open"
      ]
     },
     "periods": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "grades": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/grade"
      }
     },
     "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
     }
    }
   },
   "minItems": 1
  },
  "periods": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "grade",
     "number",
     "minutes",
     "role",
     "focus"
    ],
    "additionalProperties": false,
    "properties": {
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "number": {
      "type": "integer",
      "minimum": 1
     },
     "minutes": {
      "type": "integer"
     },
     "role": {
      "enum": [
       "teaching",
       "practice",
       "support"
      ]
     },
     "focus": {
      "$ref": "common.schema.json#/$defs/bilingual"
     },
     "materials": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/link"
      }
     },
     "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
     }
    }
   }
  },
  "provenance": {
   "$ref": "common.schema.json#/$defs/provenance"
  }
 }
}