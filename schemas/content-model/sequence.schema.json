{
 "$id": "sequence.schema.json",
 "type": "object",
 "required": [
  "pack",
  "units"
 ],
 "additionalProperties": false,
 "properties": {
  "pack": {
   "$ref": "common.schema.json#/$defs/slug"
  },
  "units": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "grade",
     "weeks",
     "title",
     "provenance"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^g[0-9]-u-w[0-9]{2}(-[0-9]{2})?$"
     },
     "grade": {
      "$ref": "common.schema.json#/$defs/grade"
     },
     "weeks": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "minItems": 1
     },
     "kind": {
      "enum": [
       "teaching",
       "periodic-revision",
       "school-readiness",
       "class-review"
      ]
     },
     "title": {
      "$ref": "common.schema.json#/$defs/text"
     },
     "objectives": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/text"
      }
     },
     "outcomes": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/link"
      }
     },
     "textbookLessons": {
      "type": "string"
     },
     "pages": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
       "guide": {
        "type": "string"
       },
       "workbook": {
        "type": "string"
       },
       "textbook": {
        "type": "string"
       }
      }
     },
     "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
     }
    }
   }
  }
 }
}