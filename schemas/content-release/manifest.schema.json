{
 "$id": "manifest.schema.json",
 "type": "object",
 "required": [
  "pack",
  "version",
  "schemaVersion",
  "counts",
  "reviewSummary",
  "pendingModels",
  "inputs",
  "entityHashes",
  "files",
  "legacyHashes"
 ],
 "additionalProperties": false,
 "properties": {
  "pack": {
   "type": "string",
   "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
  },
  "schemaVersion": {
   "enum": [
    "1.0.0",
    "1.1.0",
    "1.2.0"
   ]
  },
  "counts": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "reviewSummary": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "pendingModels": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "inputs": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "entityHashes": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "files": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "sha256",
     "bytes"
    ],
    "additionalProperties": false,
    "properties": {
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "bytes": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "legacyHashes": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "programStructure": {
   "type": "object",
   "required": [
    "file",
    "understanding",
    "profile",
    "sections",
    "pageMap",
    "status",
    "review",
    "dimensions"
   ],
   "properties": {
    "file": {
     "const": "structure.json"
    },
    "understanding": {
     "const": "program-understanding.json"
    },
    "profile": {
     "const": "PROGRAM_PROFILE.md"
    },
    "sections": {
     "const": "sections.json"
    },
    "pageMap": {
     "const": "pagemap.json"
    },
    "status": {
     "enum": [
      "not-started",
      "in-progress",
      "documented"
     ]
    },
    "review": {
     "enum": [
      "unreviewed",
      "source-compared",
      "reviewed",
      "owner-approved"
     ]
    },
    "dimensions": {
     "type": "array"
    }
   },
   "additionalProperties": false
  }
 }
}
