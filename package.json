{
  "name": "teacher-guide-navigator",
  "private": true,
  "type": "module",
  "scripts": {
    "manifest": "node scripts/asset_manifest.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check_modules.mjs",
    "verify:publication": "node scripts/verify_publications.mjs",
    "test:ingestion": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "release:assets": "node scripts/release_assets.mjs",
    "record:additions": "node scripts/record_additions.mjs",
    "verify:sources": "python3 scripts/verify_source_archive.py",
    "design:check": "node scripts/design_lock.mjs check",
    "design:approve": "node scripts/design_lock.mjs approve",
    "content:build": "node scripts/content/compile.mjs",
    "verify:content": "node scripts/content/compile.mjs --version 1.3.2 --previous 1.3.1 --check",
    "verify:program": "node scripts/content/program_metadata.mjs",
    "site:publish": "node scripts/content/publish_site.mjs",
    "verify:site": "node scripts/content/publish_site.mjs --check"
  }
}
